# /etc/engram/engram.env — environment for the engram-serve systemd unit.
#   sudo install -o root -g engram -m 0640 deploy/engram.env.example /etc/engram/engram.env
# Keep it mode 0640 root:engram: it holds API keys. Values are KEY=VALUE, no quotes.

# --- store (single-owner writes: this process is the only writer) ---------
ENGRAM_DB_PATH=/var/lib/engram/memory.db
ENGRAM_AUDIT_LOG=/var/lib/engram/audit.jsonl
ENGRAM_HOST=hub
ENGRAM_PROFILE=default

# --- serve (ADR-0009 §6: loopback only, behind `tailscale serve`) ----------
ENGRAM_SERVE_HOST=127.0.0.1
ENGRAM_SERVE_PORT=7437
# caps = require a Tailscale-App-Capabilities grant (production). none = tests only.
ENGRAM_SERVE_AUTH=caps
ENGRAM_SERVE_CAP_NAME=engram.dev/cap/engram

# --- LLM: Anthropic-native backend --------------------------------------
# Used by: memory_auto_extract / nightly digest, consolidation audit, gc scoring,
# merge, reflex drafting, skill validation tests, file summaries.
ENGRAM_LLM_PROVIDER=anthropic
ENGRAM_LLM_API_KEY=sk-ant-REPLACE-ME
ENGRAM_LLM_MODEL=claude-opus-5-5
# Optional per-task overrides (bulk extraction over nightly transcripts is a
# place where a cheaper model may be the right call — your decision):
#ENGRAM_LLM_EXTRACT_MODEL=claude-haiku-5-5
#ENGRAM_LLM_AUDIT_MODEL=claude-opus-5-5
# Optional reasoning depth (needs the anthropic SDK >= 1.0): low|medium|high|xhigh|max
#ENGRAM_LLM_EFFORT=medium
ENGRAM_LLM_TIMEOUT=120

# --- embeddings (the server is the only embedder; clients never embed) -----
# Anthropic does not offer an embeddings API, so pick one of:
#   (a) in-process, no key:  ENGRAM_EMBED_BACKEND=fastembed   (pip install 'engram-memory[fastembed]')
#   (b) Gemini (multilingual, per the hub spec): OpenAI-compatible endpoint + key, then
#       `engram migrate-embeddings` once to re-embed the store.
ENGRAM_EMBED_BACKEND=fastembed
#ENGRAM_EMBED_URL=https://generativelanguage.googleapis.com/v1beta/openai/embeddings
#ENGRAM_EMBED_API_KEY=REPLACE-ME
#ENGRAM_EMBED_MODEL=gemini-embedding-001
#ENGRAM_EMBED_DIMENSIONS=768
